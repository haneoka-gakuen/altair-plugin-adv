{
  "name": "@haneoka/altair-plugin-adv",
  "version": "0.1.0",
  "description": "Native ADV command catalogue, JSON codec, validation, compilation, and asset contributions for Altair",
  "keywords": [
    "visual-novel",
    "adv",
    "altair",
    "story-editor",
    "galgame"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-adv.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-adv/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-adv#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js",
      "default": "./dist/commands.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js",
      "default": "./dist/compiler.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./project-json": {
      "types": "./dist/project-json.d.ts",
      "import": "./dist/project-json.js",
      "default": "./dist/project-json.js"
    },
    "./resource-authoring": {
      "types": "./dist/resource-authoring.d.ts",
      "import": "./dist/resource-authoring.js",
      "default": "./dist/resource-authoring.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js",
      "default": "./dist/resources.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js",
      "default": "./dist/services.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:pack": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package && pnpm run verify:pack",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/vega-protocol": "^0.1.0",
    "@types/node": "^26.1.0",
    "@types/semver": "^7.7.1",
    "semver": "^7.7.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "altair": {
    "pluginApi": 2,
    "capabilities": [
      "assets",
      "commands",
      "compiler",
      "diagnostics",
      "format",
      "services"
    ],
    "formats": [
      "adv-json",
      "project-json"
    ],
    "nativeOpcodeRange": [
      0,
      100
    ]
  }
}
